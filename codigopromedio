#include <iostream>
using namespace std;

int main() {
    float nota, suma = 0, promedio;

    for (int i = 1; i <= 5; i++) {
        cout << "Ingrese la nota " << i << ": ";
        cin >> nota;
        suma += nota;
    }

    promedio = suma / 5;

    cout << "El promedio es: " << promedio << endl;

    if (promedio >= 9) {
        cout << "Excelente" << endl;
    } else if (promedio >= 7) {
        cout << "Bueno" << endl;
    } else {
        cout << "Regular" << endl;
    }

    return 0;
}
